# ICHIREI validation harness — server-side environment.
# Set these as Vercel Environment Variables (never commit real values).
# The API key stays server-side; it is never exposed to the frontend.

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (all have sensible defaults in engine/engine.ts):
# ICHIREI_MODEL=claude-sonnet-5
# ICHIREI_EFFORT=high          # low | medium | high | xhigh | max
# ICHIREI_MAX_TOKENS=20000
# ICHIREI_PROMPT_PATH=          # absolute path override for engine/prompt.md
# ICHIREI_CACHE_PROMPT=         # set to 1 to read prompt.md once per process
