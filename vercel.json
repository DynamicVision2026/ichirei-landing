{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/select.ts": {
      "maxDuration": 60,
      "includeFiles": "engine/**"
    },
    "api/order.ts": {
      "maxDuration": 30,
      "includeFiles": "{engine/**,src/order/**}"
    },
    "api/explain.ts": {
      "maxDuration": 60,
      "includeFiles": "engine/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
